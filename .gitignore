# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA auto-generated files
public/sw.js
public/sw.js.map
public/workbox-*.js
.env.local

# Temporary output for deterministic quant-governance tests
.quant-test/

# MetaEditor build outputs (never commit local EX5 binaries or compiler logs)
MQL5/**/*.ex5
MQL5/**/*.log
