# Supabase (server-side secret keys must never use NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Application origin and protected jobs
NEXT_PUBLIC_APP_URL=https://fidulync.vercel.app
CRON_SECRET=
MACRO_API_TOKEN=
MT5_ACCOUNT_INGEST_TOKEN=
MT5_ACCOUNT_READ_TOKEN=
# Legacy API alias accepted only for compatibility; prefer MACRO_API_TOKEN.
ALGO_PRIVATE_API_KEY=

# Shared cache (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Official macro data adapters
BLS_API_KEY=
BEA_API_KEY=
EIA_API_KEY=
FRED_API_KEY=
FRED_DATA_STORAGE_PERMISSION_APPROVED=true # private personal research default; set false to disable storage

# Public weekly FairEconomy Tier-1 calendar fallback requires no API key; optional keyed providers remain approval-gated
FINNHUB_API_KEY=
FINNHUB_PERSONAL_PLAN_ACTIVE=false
FMP_API_KEY=
FMP_COMMERCIAL_USE_APPROVED=false

# Optional research/AI providers
GEMINI_API_KEY=
GEMINI_MACRO_BRIEF_ENABLED=false
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_COMMERCIAL_USE_APPROVED=false
FX_API_KEY=

# Optional external COT source; official CFTC public data is the default
COT_DATA_PROVIDER_URL=
COT_DATA_PROVIDER_TOKEN=
