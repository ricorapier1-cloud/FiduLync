# Canonical Supabase configuration (server-side secrets must never use NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=

# Shared cache
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Private MT5 / scheduled jobs
ALGO_PRIVATE_API_KEY=
CRON_SECRET=

# Macro and market-data providers
FRED_API_KEY=
FINNHUB_API_KEY=
BEA_API_KEY=
BLS_API_KEY=
FX_API_KEY=
GEMINI_API_KEY=
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
COT_DATA_PROVIDER_URL=
COT_DATA_PROVIDER_TOKEN=
MACRO_DATA_PROVIDER_URL=
MACRO_DATA_PROVIDER_TOKEN=

# Required for live technical signals. HTTPS endpoint must return at least 200 valid candles
# for each requested pair/timeframe (H1, H4, D1), using ?pair=EURUSD&timeframe=H1.
MARKET_DATA_PROVIDER_URL=
MARKET_DATA_PROVIDER_TOKEN=

# Paystack server-side webhook and transaction verification
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Optional transactional licence email
RESEND_API_KEY=
LICENSE_FROM_EMAIL=

# Owner access / canonical origin
ADMIN_USERNAME=
ADMIN_PASSWORD=
NEXT_PUBLIC_APP_URL=

# Vercel-managed Postgres connection variables are injected by the platform when configured.
# Do not copy database passwords or connection strings into source control.
